# ─── Valorniq Environment Variables ───────────────────────────────
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` or any real secret to the repository.

# ─── Server-only secrets (NEVER prefix with VITE_) ────────────────
# Gemini API key used by the Express backend for ARIS.
GEMINI_API_KEY=

# Firebase Admin service account JSON (escaped single-line JSON).
# Server-only. Used to verify Firebase ID tokens on protected routes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Server configuration ─────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Dev-only escape hatch; keep false in production.
ALLOW_DEV_API_WITHOUT_AUTH=false

# ─── Public browser config (VITE_* is public after build) ────────
# Base URL of the Valorniq backend API. Use the dev proxy in local dev.
VITE_API_BASE_URL=
# GitHub Pages base path, e.g. /valorniq/ (must match repo name).
VITE_BASE_PATH=/

# Firebase web configuration (public client config, not a secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=